# Create a Discord application and bot at https://discord.com/developers/applications
DISCORD_BOT_TOKEN=replace-with-your-discord-bot-token
# Use a long unique password (11+ characters)
DASHBOARD_PASSWORD=replace-with-a-long-private-password
# Generate a random value of 32+ characters; never share it
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
# Local PC settings
HOST=127.0.0.1
PORT=8000
COOKIE_SECURE=false
PUBLIC_BASE_URL=http://127.0.0.1:8000
